# Diese Datei ist nur eine Vorlage. setup.sh und update.sh erzeugen tms/.env
# automatisch aus der PIM-Konfiguration (DB-Zugang + gemeinsamer API-Key).
APP_NAME=TMS
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://127.0.0.1:8001

LOG_CHANNEL=stack
LOG_LEVEL=warning

# Eigene Datenbank — per Konvention <pim-datenbank>_tms
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=publixx_pim_tms
DB_USERNAME=pim
DB_PASSWORD=

# Redis-DB 4: das PIM belegt 1 (Cache), 2 (Queue) und 3 (Session)
REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_CACHE_DB=4

QUEUE_CONNECTION=redis
CACHE_STORE=redis

# Muss zur Supervisor-Konfiguration passen (queue:work --queue=tms,default) —
# sonst arbeitet der Worker an einer anderen Queue als der Dienst befuellt.
REDIS_QUEUE=tms
QUEUE_FAILED_DRIVER=database-uuids

# MUSS identisch mit TMS_API_KEY in der PIM-.env sein, sonst antwortet
# das TMS mit 401 und der TmsClient verschluckt das still.
TMS_API_KEY=

TMS_TARGET_LANGUAGES=en,fr,es,it,nl
TMS_PROVIDER_CHAIN=deepl,google
TMS_CACHE_TTL=86400

# DeepL
DEEPL_API_KEY=
DEEPL_API_URL=https://api-free.deepl.com/v2

# Google Translate
GOOGLE_TRANSLATE_API_KEY=

# Anthropic (Claude)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
