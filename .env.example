APP_NAME="anyPIM"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ─── Database ─────────────────────────────────────────────────────────
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=publixx_pim
DB_USERNAME=root
DB_PASSWORD=

# ─── Redis (Agent 9: getrennte Instanzen) ────────────────────────────
# predis statt phpredis: umgeht einen bekannten Laravel-Bug mit PHP 8.5
# (RedisStore::scan() liefert bool statt Array -> Fatal Error bei
# Cache::tags()->flush(), siehe laravel/framework#57908 — Fix nur in 12.x).
REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_CACHE_DB=1
REDIS_QUEUE_DB=2
REDIS_SESSION_DB=3

# ─── Cache (Agent 9) ─────────────────────────────────────────────────
CACHE_STORE=redis
CACHE_PREFIX=pim

# TTL-Overrides (Sekunden)
CACHE_TTL_PRODUCT_FULL=3600
CACHE_TTL_PRODUCT_LANG=3600
CACHE_TTL_HIERARCHY_TREE=21600
CACHE_TTL_PQL_RESULT=900
CACHE_TTL_PRODUCT_LIST=300
CACHE_TTL_ATTRIBUTES_ALL=3600
CACHE_TTL_EXPORT_MAPPING=1800

# ─── Queue ────────────────────────────────────────────────────────────
QUEUE_CONNECTION=redis

# ─── Horizon (Agent 9) ───────────────────────────────────────────────
HORIZON_PREFIX=pim_horizon:

# ─── Session ──────────────────────────────────────────────────────────
SESSION_DRIVER=redis
SESSION_LIFETIME=120

# ─── Sanctum (Agent 2) ───────────────────────────────────────────────
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:3000,127.0.0.1,127.0.0.1:8000

# ─── Filesystem ──────────────────────────────────────────────────────
FILESYSTEM_DISK=local

# ─── Mail ─────────────────────────────────────────────────────────────
# Für Produktion: MAIL_MAILER=smtp und SMTP-Zugangsdaten eintragen
# Sysadmin-User erhalten kritische Fehler-Benachrichtigungen per E-Mail
MAIL_MAILER=log
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@anypim.local
MAIL_FROM_NAME="${APP_NAME}"

# ─── Fehlerklassifikation: Weiterleiten-Benachrichtigungen ───────────
# Wenn gesetzt, wird beim Klick auf "An Entwicklung weiterleiten" automatisch
# eine E-Mail und/oder eine Slack-Nachricht verschickt.
# Nicht gesetzte Kanäle werden still übersprungen.
ERROR_FORWARD_EMAIL=
ERROR_FORWARD_SLACK_WEBHOOK=

# ─── Jira-Integration ────────────────────────────────────────────────
# Wenn gesetzt, wird beim Weiterleiten automatisch ein Jira-Ticket erstellt.
# JIRA_URL: z.B. https://your-domain.atlassian.net
# JIRA_API_TOKEN: Atlassian API Token (nicht das Passwort)
JIRA_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=
JIRA_ISSUE_TYPE=Bug

# ─── Frontend (für CORS) ─────────────────────────────────────────────
FRONTEND_URL=http://localhost:3000

# ─── Typesense (PDF-Volltextsuche) ──────────────────────────────────
TYPESENSE_HOST=localhost
TYPESENSE_PORT=8108
TYPESENSE_PROTOCOL=http
TYPESENSE_API_KEY=

# ─── Meilisearch (Semantische Schnellsuche, Hybrid Search) ──────────
# Benötigt Meilisearch >= 1.10. Setup: php artisan pim:meili-setup,
# Erstbefüllung: php artisan pim:meili-index --all
MEILISEARCH_ENABLED=false
MEILISEARCH_HOST=http://localhost:7700
MEILISEARCH_API_KEY=
MEILISEARCH_INDEX=products
# Embedder: ollama (lokal) | openAi | rest | huggingFace
MEILISEARCH_EMBEDDER_ENABLED=true
MEILISEARCH_EMBEDDER_SOURCE=ollama
MEILISEARCH_EMBEDDER_MODEL=nomic-embed-text
MEILISEARCH_EMBEDDER_URL=http://localhost:11434/api/embeddings
MEILISEARCH_EMBEDDER_API_KEY=
# Gewichtung Vektor vs. Keyword (0..1) und Toleranz numerischer Filter
MEILISEARCH_SEMANTIC_RATIO=0.5
MEILISEARCH_NUMERIC_TOLERANCE=0.05

# ─── TMS (Translation Memory Service) ──────────────────────────────
TMS_ENABLED=false
TMS_BASE_URL=http://localhost:8001/api
TMS_API_KEY=change-me-to-a-secure-key
TMS_TIMEOUT=5
TMS_TARGET_LANGUAGES=en,fr,es,it,nl

# ─── MCP (Model Context Protocol) ───────────────────────────────────
# Bearer-Token für den /api/v1/mcp Endpoint (claude.ai Custom Connector).
# Leer lassen = Endpoint deaktiviert. Langes Zufalls-Secret verwenden.
MCP_AUTH_TOKEN=

# ─── In-App Copilot (Chat-Fenster im PIM) ───────────────────────────
# Nutzt standardmäßig CLAUDE_AI_API_KEY. Der Copilot bindet den eigenen
# MCP-Endpoint via Anthropic MCP-Connector ein — COPILOT_MCP_URL muss daher
# von Anthropic ÖFFENTLICH erreichbar sein (Produktion: öffentliche APP_URL).
# COPILOT_API_KEY=                       # optional, sonst CLAUDE_AI_API_KEY
COPILOT_MODEL=claude-sonnet-4-6
COPILOT_MAX_TOKENS=8192
# COPILOT_MCP_URL=https://pim.example.com/api/v1/mcp   # Default: APP_URL/api/v1/mcp

# ─── SSO (Azure AD / Entra ID) ──────────────────────────────────────
SSO_ENABLED=false
SSO_AUTO_PROVISION=true
SSO_DEFAULT_ROLE=Viewer
AZURE_AD_CLIENT_ID=
AZURE_AD_CLIENT_SECRET=
AZURE_AD_TENANT_ID=
AZURE_AD_REDIRECT_URI=${APP_URL}/api/v1/auth/sso/callback

# ─── License ─────────────────────────────────────────────────────────
# Ed25519 public key for signature verification (production only).
ANYPIM_LICENSE_PUBLIC_KEY=
# Fallback license key (persists across migrate:fresh / DB resets).
# The database-stored key always takes precedence.
ANYPIM_LICENSE_KEY=

# ─── Video Engine ────────────────────────────────────────────────────
VIDEO_ENGINE_ENABLED=true
VIDEO_ENGINE_BASE_URL=http://localhost:8000
VIDEO_ENGINE_OUTPUT_DIR=public/videos
VIDEO_ENGINE_DISPLAY=:99
VIDEO_ENGINE_FPS=30
VIDEO_ENGINE_QUALITY=high

# Demo-User für Video-Aufnahmen
VIDEO_DEMO_USER_EMAIL=demo@anypim.local
VIDEO_DEMO_USER_PASSWORD=demo1234

# ElevenLabs Text-to-Speech
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_DE_FEMALE=
ELEVENLABS_VOICE_DE_MALE=
ELEVENLABS_FALLBACK=gtts

# ─── Deployment ──────────────────────────────────────────────────────
# System user that owns the project files (for sudo in deploy commands).
# Leave empty to auto-detect from project directory owner.
DEPLOY_USER=

# ─── Security Guard (Angriffs-Erkennung / SecurityMonitor) ───────────
SECURITY_MONITOR_ENABLED=true
SECURITY_MONITOR_BLOCK=true
# Client-IP hinter Cloudflare/Proxy
SECURITY_IP_HEADER=CF-Connecting-IP
# Geo (ISO-2-Codes, kommagetrennt). Leer = keine Geo-Regel.
SECURITY_COUNTRY_HEADER=CF-IPCountry
SECURITY_ALLOWED_COUNTRIES=
SECURITY_BLOCKED_COUNTRIES=
# 4xx-Enumeration/Scanner
SECURITY_4XX_BURST=25
SECURITY_WINDOW_SECONDS=60
SECURITY_BLOCK_COOLDOWN=900
# Alarmierung (Adressen bevorzugt in der GUI unter System → Guard pflegen)
SECURITY_ALERT_MAIL=true
SECURITY_ALERT_MIN_SEVERITY=high
SECURITY_ALERT_EMAILS=
# GeoLite2 (IP→Land ohne CDN). Kostenloser MAXMIND_LICENSE_KEY nötig,
# dann: php artisan pim:geoip-update
SECURITY_GEOIP_ENABLED=true
MAXMIND_LICENSE_KEY=
MAXMIND_EDITION=GeoLite2-Country
