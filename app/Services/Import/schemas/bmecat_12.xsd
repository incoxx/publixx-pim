<?xml version="1.0" encoding="UTF-8"?>
<!--
  BMEcat 1.2 XSD Schema (abgeleitet aus der offiziellen DTD).
  Dieses Schema wird für die Validierung vor dem Import verwendet.
-->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           elementFormDefault="qualified">

  <!-- Root -->
  <xs:element name="BMECAT">
    <xs:complexType>
      <xs:sequence>
        <xs:element ref="HEADER"/>
        <xs:choice>
          <xs:element ref="T_NEW_CATALOG"/>
          <xs:element ref="T_UPDATE_PRODUCTS" minOccurs="0"/>
          <xs:element ref="T_UPDATE_PRICES" minOccurs="0"/>
        </xs:choice>
      </xs:sequence>
      <xs:attribute name="version" type="xs:string"/>
    </xs:complexType>
  </xs:element>

  <!-- HEADER -->
  <xs:element name="HEADER">
    <xs:complexType>
      <xs:all>
        <xs:element ref="CATALOG" minOccurs="0"/>
        <xs:element ref="SUPPLIER" minOccurs="0"/>
        <xs:element ref="BUYER" minOccurs="0"/>
        <xs:element ref="AGREEMENT" minOccurs="0"/>
        <xs:element ref="USER_DEFINED_EXTENSIONS" minOccurs="0"/>
      </xs:all>
    </xs:complexType>
  </xs:element>

  <xs:element name="CATALOG">
    <xs:complexType>
      <xs:all>
        <xs:element name="LANGUAGE" type="xs:string" minOccurs="0"/>
        <xs:element name="CATALOG_ID" type="xs:string" minOccurs="0"/>
        <xs:element name="CATALOG_VERSION" type="xs:string" minOccurs="0"/>
        <xs:element name="CATALOG_NAME" type="xs:string" minOccurs="0"/>
        <xs:element name="CURRENCY" type="xs:string" minOccurs="0"/>
        <xs:element name="MIME_ROOT" type="xs:string" minOccurs="0"/>
        <xs:element ref="DATETIME" minOccurs="0"/>
        <xs:element name="TERRITORY" type="xs:string" minOccurs="0"/>
      </xs:all>
    </xs:complexType>
  </xs:element>

  <xs:element name="SUPPLIER">
    <xs:complexType>
      <xs:all>
        <xs:element name="SUPPLIER_ID" minOccurs="0">
          <xs:complexType mixed="true">
            <xs:attribute name="type" type="xs:string"/>
          </xs:complexType>
        </xs:element>
        <xs:element name="SUPPLIER_NAME" type="xs:string" minOccurs="0"/>
        <xs:element ref="ADDRESS" minOccurs="0"/>
      </xs:all>
    </xs:complexType>
  </xs:element>

  <xs:element name="BUYER">
    <xs:complexType><xs:sequence><xs:any processContents="lax" minOccurs="0" maxOccurs="unbounded"/></xs:sequence></xs:complexType>
  </xs:element>
  <xs:element name="AGREEMENT">
    <xs:complexType><xs:sequence><xs:any processContents="lax" minOccurs="0" maxOccurs="unbounded"/></xs:sequence></xs:complexType>
  </xs:element>

  <xs:element name="ADDRESS">
    <xs:complexType>
      <xs:all>
        <xs:element name="NAME" type="xs:string" minOccurs="0"/>
        <xs:element name="NAME2" type="xs:string" minOccurs="0"/>
        <xs:element name="NAME3" type="xs:string" minOccurs="0"/>
        <xs:element name="STREET" type="xs:string" minOccurs="0"/>
        <xs:element name="ZIP" type="xs:string" minOccurs="0"/>
        <xs:element name="CITY" type="xs:string" minOccurs="0"/>
        <xs:element name="STATE" type="xs:string" minOccurs="0"/>
        <xs:element name="COUNTRY" type="xs:string" minOccurs="0"/>
        <xs:element name="PHONE" type="xs:string" minOccurs="0"/>
        <xs:element name="FAX" type="xs:string" minOccurs="0"/>
        <xs:element name="EMAIL" type="xs:string" minOccurs="0"/>
        <xs:element name="URL" type="xs:string" minOccurs="0"/>
        <xs:element name="CONTACT" type="xs:string" minOccurs="0"/>
      </xs:all>
      <xs:attribute name="type" type="xs:string"/>
    </xs:complexType>
  </xs:element>

  <!-- DATETIME (mixed: kann inline-Text oder DATE/TIME haben) -->
  <xs:element name="DATETIME">
    <xs:complexType mixed="true">
      <xs:all>
        <xs:element name="DATE" type="xs:string" minOccurs="0"/>
        <xs:element name="TIME" type="xs:string" minOccurs="0"/>
        <xs:element name="TIMEZONE" type="xs:string" minOccurs="0"/>
      </xs:all>
      <xs:attribute name="type" type="xs:string"/>
    </xs:complexType>
  </xs:element>

  <!-- T_NEW_CATALOG -->
  <xs:element name="T_NEW_CATALOG">
    <xs:complexType>
      <xs:sequence>
        <xs:element ref="CATALOG_GROUP_SYSTEM" minOccurs="0"/>
        <xs:element ref="ARTICLE" minOccurs="0" maxOccurs="unbounded"/>
        <xs:element ref="ARTICLE_TO_CATALOGGROUP_MAP" minOccurs="0" maxOccurs="unbounded"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>
  <xs:element name="T_UPDATE_PRODUCTS">
    <xs:complexType><xs:sequence><xs:any processContents="lax" minOccurs="0" maxOccurs="unbounded"/></xs:sequence></xs:complexType>
  </xs:element>
  <xs:element name="T_UPDATE_PRICES">
    <xs:complexType><xs:sequence><xs:any processContents="lax" minOccurs="0" maxOccurs="unbounded"/></xs:sequence></xs:complexType>
  </xs:element>

  <!-- CATALOG_GROUP_SYSTEM -->
  <xs:element name="CATALOG_GROUP_SYSTEM">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="GROUP_SYSTEM_ID" type="xs:string" minOccurs="0"/>
        <xs:element name="GROUP_SYSTEM_NAME" type="xs:string" minOccurs="0"/>
        <xs:element name="GROUP_SYSTEM_DESCRIPTION" type="xs:string" minOccurs="0"/>
        <xs:element ref="CATALOG_STRUCTURE" minOccurs="0" maxOccurs="unbounded"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>

  <xs:element name="CATALOG_STRUCTURE">
    <xs:complexType>
      <xs:all>
        <xs:element name="GROUP_ID" type="xs:string"/>
        <xs:element name="GROUP_NAME" type="xs:string" minOccurs="0"/>
        <xs:element name="GROUP_DESCRIPTION" type="xs:string" minOccurs="0"/>
        <xs:element name="PARENT_ID" type="xs:string" minOccurs="0"/>
        <xs:element name="GROUP_ORDER" type="xs:string" minOccurs="0"/>
        <xs:element ref="USER_DEFINED_EXTENSIONS" minOccurs="0"/>
        <xs:element ref="MIME_INFO" minOccurs="0"/>
      </xs:all>
      <xs:attribute name="type" type="xs:string"/>
    </xs:complexType>
  </xs:element>

  <!-- ARTICLE (BMEcat 1.2) -->
  <!-- ARTICLE: Sequenz mit flexiblen Blöcken nach SUPPLIER_AID -->
  <xs:element name="ARTICLE">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="SUPPLIER_AID" type="xs:string"/>
        <xs:choice minOccurs="0" maxOccurs="unbounded">
          <xs:element ref="ARTICLE_DETAILS"/>
          <xs:element ref="ARTICLE_FEATURES"/>
          <xs:element ref="ARTICLE_ORDER_DETAILS"/>
          <xs:element ref="ARTICLE_PRICE_DETAILS"/>
          <xs:element ref="MIME_INFO"/>
          <xs:element ref="ARTICLE_REFERENCE"/>
          <xs:element ref="USER_DEFINED_EXTENSIONS"/>
          <xs:element ref="ARTICLE_TO_CATALOGGROUP_MAP"/>
        </xs:choice>
      </xs:sequence>
      <xs:attribute name="mode" type="xs:string"/>
    </xs:complexType>
  </xs:element>

  <!-- ARTICLE_DETAILS: Sequence wegen KEYWORD/DESCRIPTION die mehrfach vorkommen -->
  <xs:element name="ARTICLE_DETAILS">
    <xs:complexType>
      <xs:sequence>
        <xs:element ref="DESCRIPTION_SHORT_MULTILANG" minOccurs="0" maxOccurs="unbounded"/>
        <xs:element ref="DESCRIPTION_LONG_MULTILANG" minOccurs="0" maxOccurs="unbounded"/>
        <xs:element name="EAN" type="xs:string" minOccurs="0"/>
        <xs:element name="SUPPLIER_ALT_AID" type="xs:string" minOccurs="0"/>
        <xs:element name="BUYER_AID" minOccurs="0">
          <xs:complexType mixed="true"><xs:attribute name="type" type="xs:string"/></xs:complexType>
        </xs:element>
        <xs:element name="MANUFACTURER_NAME" type="xs:string" minOccurs="0"/>
        <xs:element name="MANUFACTURER_PID" type="xs:string" minOccurs="0"/>
        <xs:element name="MANUFACTURER_AID" type="xs:string" minOccurs="0"/>
        <xs:element name="DELIVERY_TIME" type="xs:string" minOccurs="0"/>
        <xs:element ref="KEYWORD_MULTILANG" minOccurs="0" maxOccurs="unbounded"/>
        <xs:element name="SPECIAL_TREATMENT_CLASS" minOccurs="0">
          <xs:complexType mixed="true"><xs:attribute name="type" type="xs:string"/></xs:complexType>
        </xs:element>
        <xs:element name="ARTICLE_STATUS" minOccurs="0">
          <xs:complexType mixed="true"><xs:attribute name="type" type="xs:string"/></xs:complexType>
        </xs:element>
      </xs:sequence>
    </xs:complexType>
  </xs:element>

  <!-- Multilang-fähige Textelemente (substitutionGroup pattern) -->
  <xs:element name="DESCRIPTION_SHORT_MULTILANG" abstract="true"/>
  <xs:element name="DESCRIPTION_SHORT" substitutionGroup="DESCRIPTION_SHORT_MULTILANG" type="xs:string"/>

  <xs:element name="DESCRIPTION_LONG_MULTILANG" abstract="true"/>
  <xs:element name="DESCRIPTION_LONG" substitutionGroup="DESCRIPTION_LONG_MULTILANG" type="xs:string"/>

  <xs:element name="KEYWORD_MULTILANG" abstract="true"/>
  <xs:element name="KEYWORD" substitutionGroup="KEYWORD_MULTILANG" type="xs:string"/>

  <!-- Features -->
  <xs:element name="ARTICLE_FEATURES">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="REFERENCE_FEATURE_SYSTEM_NAME" type="xs:string" minOccurs="0"/>
        <xs:element name="REFERENCE_FEATURE_GROUP_ID" type="xs:string" minOccurs="0"/>
        <xs:element name="REFERENCE_FEATURE_GROUP_NAME" type="xs:string" minOccurs="0"/>
        <xs:element ref="FEATURE" minOccurs="0" maxOccurs="unbounded"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>

  <xs:element name="FEATURE">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="FNAME" type="xs:string"/>
        <xs:element name="FVALUE" type="xs:string" minOccurs="0" maxOccurs="unbounded"/>
        <xs:element name="FUNIT" type="xs:string" minOccurs="0"/>
        <xs:element name="FORDER" type="xs:string" minOccurs="0"/>
        <xs:element name="FDESCR" type="xs:string" minOccurs="0"/>
        <xs:element name="FVALUE_TYPE" type="xs:string" minOccurs="0"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>

  <!-- Order Details -->
  <xs:element name="ARTICLE_ORDER_DETAILS">
    <xs:complexType>
      <xs:all>
        <xs:element name="ORDER_UNIT" type="xs:string" minOccurs="0"/>
        <xs:element name="CONTENT_UNIT" type="xs:string" minOccurs="0"/>
        <xs:element name="NO_CU_PER_OU" type="xs:string" minOccurs="0"/>
        <xs:element name="PRICE_QUANTITY" type="xs:string" minOccurs="0"/>
        <xs:element name="QUANTITY_MIN" type="xs:string" minOccurs="0"/>
        <xs:element name="QUANTITY_INTERVAL" type="xs:string" minOccurs="0"/>
      </xs:all>
    </xs:complexType>
  </xs:element>

  <!-- Price Details -->
  <xs:element name="ARTICLE_PRICE_DETAILS">
    <xs:complexType>
      <xs:sequence>
        <xs:element ref="DATETIME" minOccurs="0" maxOccurs="unbounded"/>
        <xs:element ref="ARTICLE_PRICE" minOccurs="0" maxOccurs="unbounded"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>

  <xs:element name="ARTICLE_PRICE">
    <xs:complexType>
      <xs:all>
        <xs:element name="PRICE_AMOUNT" type="xs:string"/>
        <xs:element name="PRICE_CURRENCY" type="xs:string" minOccurs="0"/>
        <xs:element name="TAX" type="xs:string" minOccurs="0"/>
        <xs:element name="PRICE_FACTOR" type="xs:string" minOccurs="0"/>
        <xs:element name="LOWER_BOUND" type="xs:string" minOccurs="0"/>
        <xs:element name="TERRITORY" type="xs:string" minOccurs="0"/>
        <xs:element name="DAILY_PRICE" type="xs:string" minOccurs="0"/>
      </xs:all>
      <xs:attribute name="price_type" type="xs:string"/>
    </xs:complexType>
  </xs:element>

  <xs:element name="ARTICLE_REFERENCE">
    <xs:complexType>
      <xs:all><xs:element name="ART_ID_TO" type="xs:string"/></xs:all>
      <xs:attribute name="type" type="xs:string"/>
    </xs:complexType>
  </xs:element>

  <xs:element name="ARTICLE_TO_CATALOGGROUP_MAP">
    <xs:complexType>
      <xs:all>
        <xs:element name="ART_ID" type="xs:string"/>
        <xs:element name="CATALOG_GROUP_ID" type="xs:string"/>
        <xs:element name="ARTICLE_TO_CATALOGGROUP_MAP_ORDER" type="xs:string" minOccurs="0"/>
      </xs:all>
    </xs:complexType>
  </xs:element>

  <!-- MIME_INFO -->
  <xs:element name="MIME_INFO">
    <xs:complexType>
      <xs:sequence><xs:element ref="MIME" minOccurs="0" maxOccurs="unbounded"/></xs:sequence>
    </xs:complexType>
  </xs:element>

  <xs:element name="MIME">
    <xs:complexType>
      <xs:all>
        <xs:element name="MIME_TYPE" type="xs:string" minOccurs="0"/>
        <xs:element name="MIME_SOURCE" type="xs:string" minOccurs="0"/>
        <xs:element name="MIME_DESCR" type="xs:string" minOccurs="0"/>
        <xs:element name="MIME_ALT" type="xs:string" minOccurs="0"/>
        <xs:element name="MIME_PURPOSE" type="xs:string" minOccurs="0"/>
        <xs:element name="MIME_ORDER" type="xs:string" minOccurs="0"/>
      </xs:all>
    </xs:complexType>
  </xs:element>

  <!-- USER_DEFINED_EXTENSIONS -->
  <xs:element name="USER_DEFINED_EXTENSIONS">
    <xs:complexType>
      <xs:sequence><xs:any processContents="lax" minOccurs="0" maxOccurs="unbounded"/></xs:sequence>
    </xs:complexType>
  </xs:element>

</xs:schema>
