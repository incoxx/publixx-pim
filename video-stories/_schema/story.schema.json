{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "anyPIM Video Story",
  "description": "Schema für anyPIM Video-Story-Definitionen",
  "type": "object",
  "required": ["meta", "steps"],
  "additionalProperties": false,
  "properties": {
    "meta": {
      "type": "object",
      "required": ["id", "title", "description", "version"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$",
          "description": "Eindeutige ID, muss dem Verzeichnisnamen entsprechen"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        },
        "version": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+$"
        },
        "duration_estimate": {
          "type": "integer",
          "minimum": 1,
          "description": "Geschätzte Dauer in Sekunden"
        },
        "tags": {
          "type": "array",
          "items": { "type": "string" }
        },
        "voice": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "lang": {
              "type": "string",
              "default": "de"
            },
            "gender": {
              "type": "string",
              "enum": ["male", "female"],
              "default": "female"
            },
            "provider": {
              "type": "string",
              "enum": ["elevenlabs", "gtts"],
              "default": "elevenlabs"
            },
            "voice_id": {
              "type": "string",
              "description": "ElevenLabs Voice ID, leer = Standardstimme"
            }
          }
        },
        "viewport": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "width": { "type": "integer", "default": 1920 },
            "height": { "type": "integer", "default": 1080 }
          }
        },
        "slow_mo": {
          "type": "integer",
          "minimum": 0,
          "default": 600,
          "description": "Millisekunden zwischen Playwright-Aktionen"
        },
        "seeder": {
          "type": "string",
          "description": "Seeder-Klassenname der vor dem Recording läuft"
        },
        "seeder_reset": {
          "type": "boolean",
          "default": false,
          "description": "DB zurücksetzen vor Seeder (nie in production)"
        }
      }
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "action"],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$",
            "description": "Eindeutige Step-ID innerhalb der Story"
          },
          "action": {
            "type": "string",
            "enum": [
              "navigate",
              "click",
              "fill",
              "select",
              "select_tree",
              "upload",
              "hover",
              "scroll",
              "wait",
              "highlight",
              "screenshot",
              "assert_visible"
            ]
          },
          "target": {
            "type": "string",
            "description": "URL für navigate-Action"
          },
          "selector": {
            "type": "string",
            "description": "CSS-Selektor für das Zielelement"
          },
          "value": {
            "type": "string",
            "description": "Eingabewert für fill/select/select_tree"
          },
          "file": {
            "type": "string",
            "description": "Dateipfad relativ zu /video-stories/ für upload"
          },
          "direction": {
            "type": "string",
            "enum": ["up", "down"],
            "description": "Scrollrichtung für scroll-Action"
          },
          "duration": {
            "type": "integer",
            "minimum": 0,
            "description": "Wartezeit in ms für wait-Action"
          },
          "wait_for": {
            "type": "string",
            "description": "CSS-Selektor, auf den nach der Aktion gewartet wird"
          },
          "wait_timeout": {
            "type": "integer",
            "minimum": 0,
            "default": 5000,
            "description": "Timeout in ms für wait_for"
          },
          "sprecher": {
            "type": "string",
            "description": "Sprechertext für Voiceover/Untertitel"
          },
          "pause_after": {
            "type": "integer",
            "minimum": 0,
            "description": "Pause in ms nach dem Step"
          },
          "type_speed": {
            "type": "integer",
            "minimum": 0,
            "description": "Millisekunden pro Zeichen bei fill-Action"
          }
        },
        "allOf": [
          {
            "if": { "properties": { "action": { "const": "navigate" } } },
            "then": { "required": ["target"] }
          },
          {
            "if": { "properties": { "action": { "const": "click" } } },
            "then": { "required": ["selector"] }
          },
          {
            "if": { "properties": { "action": { "const": "fill" } } },
            "then": { "required": ["selector", "value"] }
          },
          {
            "if": { "properties": { "action": { "const": "select" } } },
            "then": { "required": ["selector", "value"] }
          },
          {
            "if": { "properties": { "action": { "const": "select_tree" } } },
            "then": { "required": ["selector", "value"] }
          },
          {
            "if": { "properties": { "action": { "const": "upload" } } },
            "then": { "required": ["selector", "file"] }
          },
          {
            "if": { "properties": { "action": { "const": "hover" } } },
            "then": { "required": ["selector"] }
          },
          {
            "if": { "properties": { "action": { "const": "wait" } } },
            "then": { "required": ["duration"] }
          },
          {
            "if": { "properties": { "action": { "const": "highlight" } } },
            "then": { "required": ["selector"] }
          },
          {
            "if": { "properties": { "action": { "const": "assert_visible" } } },
            "then": { "required": ["selector"] }
          }
        ]
      }
    }
  }
}
