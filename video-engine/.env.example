# anyPIM Video Engine – Umgebungsvariablen

# anyPIM Basis-URL (für Playwright)
ANYPIM_BASE_URL=http://localhost:8000

# Demo-User für Video-Aufnahmen
VIDEO_DEMO_USER_EMAIL=demo@anypim.local
VIDEO_DEMO_USER_PASSWORD=demo1234

# Ausgabe
VIDEO_OUTPUT_DIR=../public/videos
VIDEO_STORAGE_DIR=../storage/video-engine

# Xvfb Display
VIDEO_DISPLAY=:99

# ffmpeg Einstellungen
VIDEO_FPS=30
VIDEO_QUALITY=high

# ElevenLabs TTS
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_DE_FEMALE=
ELEVENLABS_VOICE_DE_MALE=
ELEVENLABS_VOICE_FR_FEMALE=
ELEVENLABS_VOICE_EN_FEMALE=

# Fallback TTS (gtts | silent)
ELEVENLABS_FALLBACK=gtts

# S3 Upload (optional)
VIDEO_S3_UPLOAD=false
AWS_BUCKET=
